{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "editorengine"
  ],
  "ios": {
    "iosModuleName": "NitroEditorEngine"
  },
  "android": {
    "androidNamespace": [
      "editorengine"
    ],
    "androidCxxLibName": "NitroEditorEngine"
  },
  "autolinking": {
    "EditorEngine": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridEditorEngine"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
